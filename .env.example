# ----------------------------------------------------------------------------
# JobPilot - Environment Configuration Example
# Copy this file to .env and fill in real values. Never commit the real .env.
# ----------------------------------------------------------------------------

# General
APP_ENV=development

# Backend
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
POSTGRES_PORT=5432

# File storage
# STORAGE_PROVIDER currently supports: local
# Future providers (not implemented in V0): s3, gcs, azure_blob, r2
STORAGE_PROVIDER=local
STORAGE_PATH=./storage/resumes
MAX_RESUME_SIZE_MB=10

# AI provider (V0.2 Resume Intelligence)
# AI_PROVIDER currently supports: anthropic, disabled
# Without an API key, resume analysis reports "AI not configured" instead of failing hard.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=16000
RESUME_MAX_TEXT_CHARS=60000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
