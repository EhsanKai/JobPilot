# ----------------------------------------------------------------------------
# JobPilot - Environment Configuration Example
#
# Docker (recommended):   cp .env.example .env   then   docker compose up --build
#   Docker Compose reads this file for the values below. Every value has a safe local
#   default, so the stack also starts without a .env file at all.
# Host development (contributors running uvicorn / next dev directly): the same file is
#   read by the backend from backend/.env -- see docs/docker-development.md.
#
# Never commit the real .env. NEXT_PUBLIC_* values end up in the browser bundle: never
# put a secret in one.
# ----------------------------------------------------------------------------

# Environment: development | test | production
#   production refuses to start with the development defaults below (SECRET_KEY, the
#   jobpilot/jobpilot database credentials, wildcard CORS, private browser hosts).
#   "Manual testing" is development + `docker compose --profile manual-test` (synthetic
#   test user); the seed refuses to run in production.
APP_ENV=development

# Backend
# Development placeholder. For production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Explicit origin(s) of the frontend, comma separated. Never "*".
BACKEND_CORS_ORIGINS=http://localhost:3000
# Brute-force protection (V0.13): failed sign-ins per account / per client address
# within the window, and registrations per address.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTRATION_MAX_PER_IP=10
# Only behind a reverse proxy you control: use X-Forwarded-For as the client address.
TRUST_PROXY_HEADERS=false
# Leave unset for the defaults: HSTS and no API docs in production, the opposite otherwise.
# SECURITY_HSTS_ENABLED=
# API_DOCS_ENABLED=
MAX_REQUEST_BODY_MB=15

# Database (PostgreSQL)
# Inside Docker Compose the backend always uses the `postgres` service (built from the
# POSTGRES_* values); DATABASE_URL is for host development only.
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
# Host ports (127.0.0.1 only). Change one if it is already taken on your machine.
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# File storage
# STORAGE_PROVIDER currently supports: local (a Docker volume in Compose)
# Future providers (not implemented): s3, gcs, azure_blob, r2
STORAGE_PROVIDER=local
STORAGE_PATH=./storage/resumes
MAX_RESUME_SIZE_MB=10

# AI provider (V0.2 Resume Intelligence)
# AI_PROVIDER currently supports: anthropic, disabled
# Without an API key, AI features report "AI not configured" instead of failing hard;
# everything else (profile, jobs, matching, tracking, privacy) works without one.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=16000
RESUME_MAX_TEXT_CHARS=60000
# V0.13 privacy: new accounts start with external AI processing allowed (each user can
# switch it off in Settings > Privacy). false makes it an opt-in -- a legal decision,
# see docs/privacy.md.
AI_PROCESSING_DEFAULT_ALLOWED=true
# Replace e-mail addresses and phone numbers in resume text with placeholders before it
# is sent to the AI provider.
AI_PSEUDONYMIZE_CONTACT_DETAILS=true
# Tailored documents (V0.8): a generation still "in progress" after this many
# minutes is treated as failed, so the UI is never stuck on it.
DOCUMENT_GENERATION_STALE_MINUTES=10

# Job Discovery (V0.3)
# The implemented sources (Greenhouse Job Board API, Lever Postings API) are
# public and need NO credentials. Configure which company boards to read.
JOB_SOURCES_ENABLED=greenhouse,lever
# Board tokens from job-boards.greenhouse.io/{token}; optional "token:Display Name"
GREENHOUSE_BOARD_TOKENS=getyourguide,hellofresh,grover
# Site names from jobs.lever.co/{site}; optional "site:Display Name"
LEVER_SITES=ppro:PPRO,netlight:Netlight
# global (api.lever.co) or eu (api.eu.lever.co)
LEVER_INSTANCE=global
JOB_SOURCE_TIMEOUT_SECONDS=20
JOB_SOURCE_MAX_JOBS_PER_BOARD=1000
JOB_DISCOVERY_STALE_MINUTES=10

# Job Intelligence (V0.4)
# A source posting no discovery run has received for this many days is
# reported as "stale" (never deleted).
JOB_POSTING_STALE_DAYS=14
# Bounded retries for transient source failures (timeouts, 429, 5xx), V0.4.1.
JOB_SOURCE_MAX_RETRIES=2
JOB_SOURCE_RETRY_BACKOFF_SECONDS=0.5

# Browser assistant (V0.10): JobPilot opens the application page in a Chromium it controls
# and fills only the answers you approved. Submitting needs your final review and an
# explicit authorization (V0.11).
# In Docker the browser always runs headless (the live view is a screenshot). On the host:
# false = a visible window on this machine (you can watch and take over); true = no window.
AUTOMATION_BROWSER_HEADLESS=false
# AUTOMATION_CHROMIUM_PATH=
# localhost / private-network addresses are refused (application URLs, redirects and every
# request the page makes -- V0.13 egress filter) unless this is true. Development/tests only;
# refused in production.
AUTOMATION_ALLOW_PRIVATE_HOSTS=false
AUTOMATION_NAVIGATION_TIMEOUT_SECONDS=30
AUTOMATION_IDLE_CLOSE_MINUTES=30
AUTOMATION_MAX_BROWSERS=3
AUTOMATION_MAX_FIELDS=300

# Frontend (compiled into the browser bundle at build time: public, never a secret)
# The URL the *browser* uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
