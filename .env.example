# ----------------------------------------------------------------------------
# JobPilot - Environment Configuration Example
# Copy this file to .env and fill in real values. Never commit the real .env.
# ----------------------------------------------------------------------------

# General
APP_ENV=development

# Backend
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
POSTGRES_PORT=5432

# File storage
# STORAGE_PROVIDER currently supports: local
# Future providers (not implemented in V0): s3, gcs, azure_blob, r2
STORAGE_PROVIDER=local
STORAGE_PATH=./storage/resumes
MAX_RESUME_SIZE_MB=10

# AI provider (V0.2 Resume Intelligence)
# AI_PROVIDER currently supports: anthropic, disabled
# Without an API key, resume analysis reports "AI not configured" instead of failing hard.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=16000
RESUME_MAX_TEXT_CHARS=60000

# Job Discovery (V0.3)
# The implemented sources (Greenhouse Job Board API, Lever Postings API) are
# public and need NO credentials. Configure which company boards to read.
JOB_SOURCES_ENABLED=greenhouse,lever
# Board tokens from job-boards.greenhouse.io/{token}; optional "token:Display Name"
GREENHOUSE_BOARD_TOKENS=getyourguide,hellofresh,grover
# Site names from jobs.lever.co/{site}; optional "site:Display Name"
LEVER_SITES=ppro:PPRO,netlight:Netlight
# global (api.lever.co) or eu (api.eu.lever.co)
LEVER_INSTANCE=global
JOB_SOURCE_TIMEOUT_SECONDS=20
JOB_SOURCE_MAX_JOBS_PER_BOARD=1000
JOB_DISCOVERY_STALE_MINUTES=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
